DJANGO_SECRET_KEY=replace_with_random_hex
ADMIN_EMAIL=admin@chiro.gov.et
ADMIN_PASSWORD=replace_with_strong_password
CAS_DATA_DIR=/srv/cas
# Optional SMTP: EMAIL_HOST, EMAIL_PORT, EMAIL_HOST_USER, EMAIL_HOST_PASSWORD, DEFAULT_FROM_EMAIL

AUTH_MODE=keycloak
KEYCLOAK_URL=https://auth.chirocity.gov.et
KEYCLOAK_REALM=cas
KEYCLOAK_CLIENT_ID=cas-web
KEYCLOAK_AUDIENCE=cas-api

# CAS only: keep true unless email confirmation is explicitly optional.
CAS_REQUIRE_VERIFIED_EMAIL=true

# Server-only provisioner from the cas realm; never expose its secret to the frontend.
KEYCLOAK_ADMIN_CLIENT_ID=cas-provisioner
KEYCLOAK_ADMIN_CLIENT_SECRET=
